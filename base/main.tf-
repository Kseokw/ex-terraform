#     "ap-southeast-1c" = aws_subnet.std07_public_subnet[2].id
#   }
#   subnet_id      = each.value
#   route_table_id = aws_route_table.std07_public_rt.id
# }

# resource "aws_route_table_association" "std07_public_1a_rt_association" {
#   subnet_id      = aws_subnet.std07_public_1a_subnet.id
#   route_table_id = aws_route_table.std07_public_rt.id
# }

# 3. 라우팅
resource "aws_route" "std07_public_rt_route" {
  route_table_id         = aws_route_table.std07_public_rt.id
  destination_cidr_block = "0.0.0.0/0"
  gateway_id             = aws_internet_gateway.std07_igw.id
}

# =========================================================
# # private Route Table 생성
resource "aws_route_table" "std07_private_rt" {
  count  = length(local.azs)
  vpc_id = aws_vpc.std07_vpc.id

  tags = {
    Name = "${local.tag_header}private-${local.azs[count.index]}-rt"
  }
}
